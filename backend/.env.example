# M-Pesa Daraja API Credentials & Configuration
MPESA_CONSUMER_KEY="YOUR_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_CONSUMER_SECRET"
MPESA_SHORTCODE="YOUR_BUSINESS_SHORTCODE" # e.g., 174379
MPESA_PASSKEY="YOUR_PASSKEY"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline" # Or "CustomerBuyGoodsOnline"
MPESA_CALLBACK_URL_BASE="https://yourdomain.com" # Or your ngrok URL for testing, e.g., https://xxxx.ngrok.io
MPESA_API_ENV="sandbox" # 'sandbox' or 'live'

# Other existing variables (ensure these are also documented if not already)
# MONGO_URI=mongodb://localhost:27017/isp_mvp
# JWT_SECRET=yourjwtsecretkeyforispwebapp
# PORT=5000 # Optional, if you want to specify a default port

# Email SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secretpassword
EMAIL_FROM=noreply@example.com
